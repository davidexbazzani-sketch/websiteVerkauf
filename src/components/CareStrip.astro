---
/** Schmale Zeile mit Label und zwei, drei Einträgen – Pflege-Abos unter den Preisen oder das Versprechen. */
import { config, type CarePlan } from '../config';

interface Props { label?: string; plans?: CarePlan[]; class?: string }
const { label = 'Pflege-Abos', plans = config.care, class: className } = Astro.props;
---
<div class:list={['lu-care', className]}>
  <p class="lu-care__label" style="margin: 0">{label}</p>
  <ul class="lu-care__plans">
    {plans.map((p) => (
      <li class="lu-care__plan"><strong>{p.price ? `${p.name} · ${p.price}` : p.name}</strong><br />{p.text}</li>
    ))}
  </ul>
</div>
