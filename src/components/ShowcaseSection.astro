---
/** Sektion „Vorher / Nachher“ (#beispiele): Vergleichs-Slider und drei Beispielkarten. */
import { config } from '../config';
import SectionHeading from './SectionHeading.astro';
import BeforeAfter from './BeforeAfter.astro';
import Card from './Card.astro';
import PhotoPlaceholder from './PhotoPlaceholder.astro';

interface Props { id?: string; initial?: number; class?: string }
const { id = 'beispiele', initial = 50, class: className } = Astro.props;
---
<section class:list={['lu-section', 'lu-section--sky', className]} id={id} aria-labelledby="beispiele-titel">
  <div class="lu-container lu-section__inner">
    <SectionHeading eyebrow="Vorher / Nachher" title={config.showcase.title} titleId="beispiele-titel" />
    <div class="lu-showcase__ba">
      <BeforeAfter initial={initial} caption="Links eine veraltete Website, rechts ein moderner Entwurf." />
      <div class="lu-showcase__ba-text">
        <h3 class="lu-card__title">{config.showcase.sliderTitle}</h3>
        <p>{config.showcase.sliderText}</p>
      </div>
    </div>
    <div class="lu-showcase__grid">
      {config.examples.map((e) => (
        <Card tone="paper" badge="Beispiel" title={e.title} href={e.href ?? '#kontakt'} more="Ähnlichen Entwurf anfragen" text={e.text}>
          <PhotoPlaceholder slot="media" label={e.photo} tone={e.tone} />
        </Card>
      ))}
    </div>
  </div>
</section>
