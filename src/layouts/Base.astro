---
/**
 * Grundgerüst jeder Seite: <head> mit Title, Meta, Open Graph, Favicon,
 * Schrift-Preload und den drei Stylesheets. Der Name kommt aus src/config.ts.
 */
import '../styles/tokens.css';
import '../styles/components.css';
import '../styles/site.css';
import { config } from '../config';

interface Props {
  /** Seitentitel ohne Namen – der Name wird angehängt. Leer = nur der Name. */
  title?: string;
  description?: string;
  /** Slug des Open-Graph-Bilds unter /og/<slug>.png */
  ogSlug?: 'start' | 'impressum' | 'datenschutz';
  /** Seite nicht in Suchmaschinen aufnehmen (z. B. 404, Danke) */
  noindex?: boolean;
}

const { title, description = config.description, ogSlug = 'start', noindex = false } = Astro.props;
const fullTitle = title ? `${title} – ${config.name}` : `${config.name} – ${config.tagline}`;
const canonical = new URL(Astro.url.pathname, config.site).href;
const ogImage = new URL(`/og/${ogSlug}.png`, config.site).href;
---
<!doctype html>
<html lang="de" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#fffbf5" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={config.name} />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${config.name} – ${config.description}`} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preload" href="/fonts/fraunces-latin-opsz-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/fraunces-latin-opsz-italic.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />

    <script is:inline>document.documentElement.classList.remove('no-js');</script>
  </head>
  <body class="lu-root">
    <slot />
  </body>
</html>
